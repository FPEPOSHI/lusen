{
    "name": "fpeposhi/lusen",
    "description": "Fast, SEO- and AI-agent-friendly API documentation for Laravel applications.",
    "keywords": ["laravel", "api", "documentation", "openapi", "llms-txt", "mcp", "seo"],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "fpeposhi",
            "email": "festimpeposhi95@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "league/commonmark": "^2.4",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Lusen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lusen\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lusen\\LusenServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "lint": "pint",
        "lint:test": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@lint:test",
            "@analyse",
            "@test"
        ]
    }
}
